#!/bin/sh
# Sets up sshd for the EC2 tunnel, and writes the developer keys.
# Terraform renders this file, and SSM Run Command runs it as root through
# the association in main.tf.
#
# The script checks the values that sshd will use before it restarts sshd,
# and writes the keys last. If a check fails, sshd is not restarted, every
# key is removed, the association fails, and terraform apply reports it.
set -eu

# Empty authorized_keys, so that no key can log in.
revoke_keys() {
  if [ -d /home/ec2-user/.ssh ]; then
    : > /home/ec2-user/.ssh/authorized_keys
  fi
}

install -d -m 0755 /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/00-ec2-tunnel.conf <<'EOF'
# EC2 tunnel: bind remote forwards to the address that the client asks for,
# allow remote forwards only, and close dead sessions after about 90 seconds.
GatewayPorts clientspecified
AllowTcpForwarding remote
AllowStreamLocalForwarding no
ClientAliveInterval 30
ClientAliveCountMax 3
EOF

sshd -t

# The values that sshd will use for a login of ec2-user over the SSM
# connection. sshd -T reads the files, not the running sshd, so this runs
# before the restart. An earlier setting in another file wins over this
# file, so check them.
effective="$(sshd -T -C user=ec2-user,host=localhost,addr=127.0.0.1,laddr=127.0.0.1,lport=22)"
for expected in \
  "gatewayports clientspecified" \
  "allowtcpforwarding remote" \
  "allowstreamlocalforwarding no" \
  "clientaliveinterval 30" \
  "clientalivecountmax 3"; do
  if ! printf '%s\n' "$effective" | grep -qxF "$expected"; then
    revoke_keys
    echo "ec2-tunnel: sshd would not use '$expected'. sshd was not restarted, and all keys were removed." >&2
    exit 1
  fi
done

systemctl restart sshd

# Replace the whole file, so it holds only the keys below.
install -d -m 0700 -o ec2-user -g ec2-user /home/ec2-user/.ssh
cat > /home/ec2-user/.ssh/authorized_keys.new <<'EOF'
%{ for name, key in developer_keys ~}
restrict,port-forwarding,permitlisten="0.0.0.0:${tunnel_port}",command="/bin/false" ${key} ec2-tunnel-${name}
%{ endfor ~}
EOF
chown ec2-user:ec2-user /home/ec2-user/.ssh/authorized_keys.new
chmod 0600 /home/ec2-user/.ssh/authorized_keys.new
mv -f /home/ec2-user/.ssh/authorized_keys.new /home/ec2-user/.ssh/authorized_keys

echo "ec2-tunnel: sshd is set up, and ${length(developer_keys)} keys are written."
